// Alloy for compose: tail every container of this project and push to Loki with the
// labels app and process, taken from the containers' bb.* labels (docs/logs.md §2).
// Ids stay inside the JSON line; they are never labels.

discovery.docker "project" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT")]
  }
}

discovery.relabel "labels" {
  targets = discovery.docker.project.targets
  rule {
    source_labels = ["__meta_docker_container_label_bb_app"]
    target_label  = "app"
  }
  rule {
    source_labels = ["__meta_docker_container_label_bb_process"]
    target_label  = "process"
  }
  rule {
    source_labels = ["__meta_docker_container_label_bb_app"]
    regex         = ""
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.labels.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
