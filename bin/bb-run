#!/usr/bin/env bash
# Launch one process of one app on this host: bb-run <app>:<role>, role in worker|scheduler|admin|serve.
# Reads ~/.config/backend-builder/<app>.env, gives each role its own ports from BB_PORT_BASE, waits for
# Postgres, then execs the backend-builder CLI. systemd's bb@.service calls this with the instance name.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
inst="${1:?usage: bb-run <app>:<role>}"
app="${inst%%:*}"; role="${inst##*:}"
envfile="$HOME/.config/backend-builder/$app.env"
[ -f "$envfile" ] || { echo "missing $envfile (run: make env APP=$app)" >&2; exit 2; }
set -a; . "$envfile"; set +a
: "${BB_PORT_BASE:?BB_PORT_BASE unset in $envfile}"
: "${BACKEND_BUILDER_DATABASE_URL:?BACKEND_BUILDER_DATABASE_URL unset in $envfile}"

# Ports: BASE = admin console, BASE+1 = API, BASE+2..5 = metrics of worker, scheduler, (admin: none), serve.
case "$role" in
  worker)    export BACKEND_BUILDER_METRICS_PORT=$((BB_PORT_BASE + 2)); cmd=(worker "$app") ;;
  scheduler) export BACKEND_BUILDER_METRICS_PORT=$((BB_PORT_BASE + 3)); cmd=(scheduler "$app") ;;
  admin)     export BACKEND_BUILDER_METRICS_PORT=$((BB_PORT_BASE + 4)); cmd=(admin "$app" --port "$BB_PORT_BASE") ;;
  serve)     export BACKEND_BUILDER_METRICS_PORT=$((BB_PORT_BASE + 5)); cmd=(serve "$app" --port $((BB_PORT_BASE + 1))) ;;
  *) echo "unknown role $role" >&2; exit 2 ;;
esac

# Wait for Postgres (the compose container may still be starting after boot).
hostport=$(printf '%s' "$BACKEND_BUILDER_DATABASE_URL" | sed -E 's#^[a-z+]+://([^@]+@)?([^/:]+):?([0-9]*)/.*#\2 \3#')
host=${hostport% *}; port=${hostport#* }; port=${port:-5432}
for _ in $(seq 1 60); do
  (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null && break
  sleep 2
done

cd "$(dirname "$0")/.."
exec uv run --frozen backend-builder "${cmd[@]}"
